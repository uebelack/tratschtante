{
  "name": "tratschtante",
  "version": "1.0.0",
  "description": "Just another simple logger for node.js",
  "keywords": [
    "console",
    "json",
    "lambda",
    "log",
    "logger",
    "logging"
  ],
  "homepage": "https://github.com/uebelack/tratschtante#readme",
  "bugs": {
    "url": "https://github.com/uebelack/tratschtante/issues"
  },
  "license": "MIT",
  "author": "David Übelacker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uebelack/tratschtante.git"
  },
  "files": [
    "src/**/*.js",
    "!src/**/__tests__/**",
    "!src/smoke.js",
    "types/**/*.d.ts",
    "types/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt .",
    "test": "vitest run",
    "types": "tsc",
    "smoke": "node src/smoke.js"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
