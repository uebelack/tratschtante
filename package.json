{
  "name": "tratschtante",
  "version": "1.0.0",
  "description": "Just another simple logger for node.js",
  "license": "MIT",
  "author": "David Übelacker",
  "repository": "https://github.com/uebelack/tratschtante",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "types": "tsc",
    "smoke": "node src/smoke.js"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "packageManager": "pnpm@12.18.0"
}
