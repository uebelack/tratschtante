{
  "include": ["src/**/*"],
  "exclude": ["src/**/*-test.js", "src/smoke.js"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "types",
    "declarationMap": true,
    "skipLibCheck": true
  }
}
